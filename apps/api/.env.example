API_ADDR=:8080
DATABASE_DSN=app:change-me@tcp(127.0.0.1:3306)/agentic_rag?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=replace-with-at-least-32-random-characters
# Internal FastAPI Agent runtime. Required only for the /api/v1/chat routes;
# the Agent service refuses to start without a matching INTERNAL_API_TOKEN.
AGENT_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_TOKEN=replace-with-the-agent-service-token
